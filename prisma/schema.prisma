generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  displayName     String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  sessions        Session[]
  wallets         Wallet[]
  watchlists      Watchlist[]
  alerts          Alert[]
  conversations   AiConversation[]
  agents          AiAgent[]
  apiKeys         ApiKey[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

enum Role { USER ADMIN DEVELOPER SUPPORT }

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  address   String
  chainId   Int
  label     String?
  connectedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, address, chainId])
  @@index([address, chainId])
}

model Asset {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String
  chain     String?
  contractAddress String?
  isActive  Boolean  @default(true)
  marketData MarketData[]
  transactions Transaction[]
}

model MarketData {
  id        String   @id @default(cuid())
  assetId   String
  provider  String
  price     Decimal  @db.Decimal(30, 12)
  change24h Decimal? @db.Decimal(12, 6)
  marketCap Decimal? @db.Decimal(30, 2)
  volume24h Decimal? @db.Decimal(30, 2)
  high24h   Decimal? @db.Decimal(30, 12)
  low24h    Decimal? @db.Decimal(30, 12)
  capturedAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, capturedAt])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String?
  assetId   String
  walletAddress String?
  txHash    String?
  chainId   Int?
  type      String
  quantity  Decimal  @db.Decimal(30, 12)
  unitPrice Decimal? @db.Decimal(30, 12)
  occurredAt DateTime
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id])
  @@index([userId, occurredAt])
  @@index([txHash])
}

model PortfolioSnapshot {
  id        String   @id @default(cuid())
  userId    String
  totalValue Decimal @db.Decimal(30, 12)
  pnl       Decimal? @db.Decimal(30, 12)
  riskScore Decimal? @db.Decimal(8, 4)
  capturedAt DateTime @default(now())
  @@index([userId, capturedAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Default")
  createdAt DateTime @default(now())
  items     WatchlistItem[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchlistItem {
  id String @id @default(cuid())
  watchlistId String
  symbol String
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  @@unique([watchlistId, symbol])
}

model Alert {
  id String @id @default(cuid())
  userId String
  type String
  symbol String?
  condition Json
  enabled Boolean @default(true)
  lastTriggeredAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, enabled])
}

model AiConversation {
  id String @id @default(cuid())
  userId String
  title String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
}

model AiMessage {
  id String @id @default(cuid())
  conversationId String
  role String
  content String
  metadata Json?
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AiAgent {
  id String @id @default(cuid())
  userId String
  name String
  status String @default("DISABLED")
  spendingLimit Decimal? @db.Decimal(30, 12)
  transactionLimit Int @default(0)
  emergencyDisabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions AgentPermission[]
  tasks AgentTask[]
}

model AgentPermission {
  id String @id @default(cuid())
  agentId String
  capability String
  requiresApproval Boolean @default(true)
  allowlist Json?
  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentTask {
  id String @id @default(cuid())
  agentId String
  status String @default("PENDING")
  input Json
  output Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([agentId, createdAt])
}

model ApiKey {
  id String @id @default(cuid())
  userId String
  name String
  keyPrefix String
  keyHash String @unique
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  resource String
  resourceId String?
  metadata Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([resource, resourceId])
  @@index([createdAt])
}

model FeatureFlag {
  id String @id @default(cuid())
  key String @unique
  enabled Boolean @default(false)
  description String?
  updatedAt DateTime @updatedAt
}
